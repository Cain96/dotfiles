#!/bin/sh
# chezmoi の modify_ スクリプト。宛先の settings.json を stdin で受け取り、
# 差し替えた JSON を stdout に出す。
#
# 素通しするもの:
#   - EXTERNAL_HOOK_RE に一致する hooks グループ。Orca が settings.json に直接注入する分
set -eu

EXTERNAL_HOOK_RE='\.orca/agent-hooks'

cur=$(cat)
[ -n "$cur" ] || cur='{}'
printf '%s' "$cur" | jq empty 2>/dev/null || cur='{}'

managed=$(cat <<'MANAGED_JSON'
{
  "cleanupPeriodDays": 60,
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "ENABLE_TOOL_SEARCH": "1",
    "ENABLE_LSP_TOOL": "1",
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "BASH_MAX_TIMEOUT_MS": "1200000",
    "SHELL": "/bin/zsh",
    "EDITOR": "cursor --wait",
    "VISUAL": "cursor --wait",
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "BUN_INSTALL_CACHE_DIR": "/tmp/claude/bun-cache",
    "NPM_CONFIG_CACHE": "/tmp/claude/npm-cache"
  },
  "attribution": {
    "commit": "🤖 Generated with Claude Code",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(pnpm:*)",
      "Bash(node:*)",
      "Bash(deno:*)",
      "Bash(biome:*)",
      "Bash(vitest:*)",
      "Bash(turbo:*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(gh-asset:*)",
      "Bash(hub:*)",
      "Bash(ls:*)",
      "Bash(cd:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(rg:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(wc:*)",
      "Bash(head:*)",
      "Bash(echo:*)",
      "Bash(pwd:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(cp:*)",
      "Bash(ln:*)",
      "Bash(date:*)",
      "Bash(tree:*)",
      "Bash(jq:*)",
      "Bash(say:*)",
      "Read(~/workspace/**)",
      "Edit(~/workspace/**)",
      "Edit(/tmp/**)",
      "Grep(**)",
      "Read(**)",
      "LS(**)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:*.github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:*.anthropic.com)",
      "WebFetch(domain:zenn.dev)",
      "WebFetch(domain:qiita.com)",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:docs.npmjs.com)",
      "WebFetch(domain:dev.classmethod.jp)",
      "WebFetch(domain:note.com)",
      "WebFetch(domain:speakerdeck.com)",
      "WebFetch(domain:dev.to)",
      "WebFetch(domain:medium.com)",
      "WebSearch",
      "Edit(!.git/**)",
      "Edit(!node_modules/**)",
      "Edit(!dist/**)",
      "NotebookRead(**)",
      "TodoRead(**)",
      "TodoWrite(**)",
      "Task(**)",
      "Skill(**)",
      "mcp__plugin_context7_context7__resolve-library-id",
      "mcp__plugin_context7_context7__query-docs"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf /*)",
      "Bash(sudo rm:*)",
      "Bash(sudo dd:*)",
      "Bash(sudo mkfs:*)",
      "Bash(sudo fdisk:*)",
      "Bash(sudo mount:*)",
      "Bash(sudo umount:*)",
      "Bash(dd:*)",
      "Bash(mkfs:*)",
      "Bash(fdisk:*)",
      "Bash(> /dev/*)",
      "Bash(>> /dev/*)",
      "Bash(sudo :*passwd:*::*)",
      "Bash(sudo :*shadow:*::*)",
      "Bash(chmod 777 /*)",
      "Bash(chown root:*)",
      "Bash(sudo chmod 777:*)",
      "Bash(sudo chown:*)",
      "Bash(sudo -i:*)",
      "Bash(sudo su:*)",
      "Bash(curl :* | sh::*)",
      "Bash(curl :* | bash::*)",
      "Bash(wget :* | sh::*)",
      "Bash(wget :* | bash::*)",
      "Bash(rm -rf .git)",
      "Bash(git push --force-with-lease origin main)",
      "Bash(git push -f origin main)",
      "Bash(docker system prune -af)",
      "Bash(npm publish:*)",
      "Bash(deno publish:*)",
      "Edit(/etc/**)",
      "Edit(/usr/**)",
      "Edit(/var/**)",
      "Edit(/opt/**)",
      "Edit(/bin/**)",
      "Edit(/sbin/**)",
      "Edit(/lib/**)",
      "Edit(/lib64/**)",
      "Edit(/boot/**)",
      "Edit(/proc/**)",
      "Edit(/sys/**)",
      "Edit(/dev/**)",
      "Edit(~/.ssh/id_*)",
      "Edit(~/.ssh/*_rsa)",
      "Edit(~/.ssh/*_ecdsa)",
      "Edit(~/.ssh/*_ed25519)",
      "Edit(/etc/passwd)",
      "Edit(/etc/shadow)",
      "Edit(/etc/sudoers)",
      "Read(~/**/.env)",
      "Read(~/**/.env.*)",
      "Edit(~/**/.env)",
      "Edit(~/**/.env.*)",
      "Read(~/.aws/credentials)",
      "Read(~/.aws/config)",
      "Edit(~/.aws/credentials)",
      "Edit(~/.aws/config)",
      "Read(~/.config/gcloud/**)",
      "Edit(~/.config/gcloud/**)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/claude/hooks/inject-datetime.sh"
          },
          {
            "type": "command",
            "command": "~/.config/claude/hooks/inject-github-username.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/claude/hooks/command-logger.sh"
          },
          {
            "type": "command",
            "command": "if jq -r '.tool_input.command' | grep -q 'git commit.*--no-verify'; then confirm-pam \"Allow git commit --no-verify?\" || (echo \"Authenticated Failed - Disallow the commit by human. Please wait and follow the instructions.\" >&2; exit 2); fi"
          },
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/claude/hooks/auto-format.sh"
          },
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Sosumi.aiff"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"承認してください！\" with title \"Claude Code\" sound name \"Crystal\"'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"処理が完了しました！\" with title \"Claude Code\" sound name \"Crystal\"'"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.plan // empty' | pbcopy"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/bin/bash ${HOME}/.config/claude/scripts/statusline-command.sh"
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "ruby-lsp@claude-plugins-official": true,
    "ast-grep@ast-grep-marketplace": true,
    "security-guidance@claude-plugins-official": true,
    "warp@claude-code-warp": true,
    "eli5@claude-community": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "ast-grep-marketplace": {
      "source": {
        "source": "github",
        "repo": "ast-grep/agent-skill"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    },
    "claude-community": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-community"
      }
    }
  },
  "language": "ja",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "registry.npmjs.org",
        "*.npmjs.org",
        "jsr.io",
        "deno.land",
        "*.anthropic.com"
      ],
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": [
        "/var/folders/*/*/T/**",
        "~/.bun/install/**"
      ],
      "denyRead": [
        "~/.ssh/**",
        "~/.aws/credentials",
        "~/.aws/config",
        "~/.config/gcloud/**",
        "~/**/.env",
        "~/**/.env.*"
      ]
    },
    "excludedCommands": [
      "git:*",
      "gh:*",
      "docker:*",
      "npm run test*",
      "agent-browser*",
      "rtk git:*",
      "rtk gh:*",
      "rtk docker:*",
      "rtk npm run test*"
    ]
  },
  "effortLevel": "high",
  "plansDirectory": "./.claude/plans",
  "theme": "dark",
  "preferredNotifChannel": "terminal_bell",
  "skipAutoPermissionPrompt": true,
  "advisorModel": "opus"
}
MANAGED_JSON
)

jq -n --argjson cur "$cur" --argjson managed "$managed" --arg external_hook_re "$EXTERNAL_HOOK_RE" '
  def is_externally_injected_group:
    (.hooks // []) | map(.command // "") | join("\n") | test($external_hook_re);

  def replace_managed_top_level_keys_leaving_others($dst):
    ($managed | del(.hooks)) as $managed_top_level
    | ($dst | delpaths($managed_top_level | keys | map([.]))) * $managed_top_level;

  def rebuild_hooks_keeping_only_externally_injected($dst):
    [ (($dst.hooks // {}) | keys[]), (($managed.hooks // {}) | keys[]) ]
    | unique
    | reduce .[] as $event
        ({};
          .[$event] = ((($dst.hooks[$event] // []) | map(select(is_externally_injected_group)))
                       + ($managed.hooks[$event] // [])))
    | with_entries(select((.value | length) > 0));

  replace_managed_top_level_keys_leaving_others($cur)
  | .hooks = rebuild_hooks_keeping_only_externally_injected($cur)
'
